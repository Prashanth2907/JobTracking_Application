# =============================================================================
# JobTrack Backend Environment Configuration Example
# Copy this file to .env and fill in your actual values
# =============================================================================

# Spring Profile ('mysql' for MySQL 8+, 'dev' for file-based H2)
SPRING_PROFILES_ACTIVE=mysql

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/jobtrack_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security
# 256-bit Hex or Base64 secret key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Expiration in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# File Storage Directory for Resumes
FILE_UPLOAD_DIR=./uploads/resumes

# Frontend Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
